+
+  static bool canTravel(String from, String to, {required bool gateUnlocked}) {
+    if (!gateUnlocked) return false;
+    return (from == town && to == river) ||
+        (from == river && (to == town || to == forest)) ||
+        (from == forest && to == river);
+  }
+}
