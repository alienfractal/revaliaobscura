          "effects": [
            {
              "set_flag": "sailor_identity_known"
            }
          ],
          "next": "npc_identity"
        },
        {
          "id": "leave",
          "next": "end"
        }
      ]
    },
    "npc_identity": {
      "responses": [
        {
          "id": "finish_identity",
          "next": "end"
        }
      ]
    },
    "npc_after_identity": {
      "responses": [
        {
          "id": "leave",
          "next": "end"
        }
      ]
    }
  }
