    "npc_identity": {
      "player_text": "Who are you?",
      "text": "A navigator. I know the Baltic coasts and the old roads.",
      "responses": {
        "mock_outfit": {
          "text": "You must have a lot of personality."
        },
        "ask_if_comedian": {
          "text": "Are you a comedian by any chance, Navigator?"
        },
        "leave": {
          "text": "I will leave you to it."
        }
      }
    },
    "npc_silent_stare": {
      "player_text": "You must have a lot of personality.",
      "text": "Who do you think you are?",
      "responses": {
        "laugh": {
          "text": "HahahaHahahaHahahaHahahaHahahaHahahaHahaha."
        },
        "ask_if_comedian": {
          "text": "I apologize."
        }
      }
    },
    "npc_defend_honor": {
      "player_text": "Hahaha.",
      "text": "I demand respect.",
      "responses": {
        "apologize": {
          "text": "I apologize."
        },
        "laugh_again": {
          "text": "Hahaha."
        },
        "leave": {
          "text": "Then I shall leave you to your honor."
        }
      }
    },
    "npc_final_insult": {
      "player_text": "Hahaha.",
      "text": "You insulted me for the last time.",
      "responses": {
        "face_consequence": {
          "text": "..."
        }
      }
    },
    "npc_hendrik_identity": {
      "player_text": "Are you a comedian, Navigator?",
      "text": "No, I am not. And the name is Hendrik.",
      "responses": {
        "ask_need": {
          "text": "What do you need?"
        },
        "leave": {
          "text": "I will leave you to it."
        }
      }
    },
    "npc_ask_name": {
      "player_text": "What do you need?",
      "text": "Interesting that you ask. Before we discuss business, what is your name?",
      "responses": {
        "answer_rebane": {
          "text": "Rebane."
        },
        "leave": {
          "text": "Perhaps another time."
        }
      }
    },
    "npc_ink_request": {
      "player_text": "Rebane.",
      "text": "Good, Rebane. I have run out of ink, and without ink my maps are useless. Bring me some, and perhaps I will decide you are worth my time.",
      "responses": {
        "accept_ink_quest": {
          "text": "I will find ink for you."
        }
      }
    },
    "npc_after_identity": {
      "player_text": "Hello again.",
      "text": "Back again? If you want a navigator's time, show me that you can notice what is needed.",
      "responses": {
        "ask_need": {
          "text": "What do you need?"
        },
        "leave": {
          "text": "Not now. Goodbye."
        }
      }
    },
    "npc_waiting_for_ink": {
      "player_text": "About that ink...",
      "text": "Bring me ink for my maps, Rebane. Then we can discuss opportunities.",
      "responses": {
        "leave": {
          "text": "I am still looking."
        }
      }
    }
