  "dialogues": {
    "npc_intro": {
      "player_text": "You look like a man who knows this place.",
      "text": "I know the Baltic roads.",
      "responses": {
        "ask_identity": {
          "text": "Who are you?"
        },
        "leave": {
          "text": "Goodbye."
        }
      }
